# KAVACH — local-only industrial AI copilot. Copy to `.env` and adjust.
# Never commit `.env`. No cloud AI endpoints.

# --- Application ---
APP_NAME=KAVACH
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
CORRELATION_ID_HEADER=X-Correlation-ID

# --- Persistence ---
DATABASE_URL=sqlite:///./data/kavach.db

# --- Uploads ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=52428800
ALLOWED_MIME_TYPES=application/pdf,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/csv,application/csv
IMAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/jpg

# --- Chunking ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TIKTOKEN_ENCODING=cl100k_base

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=3
OLLAMA_RETRY_BACKOFF_SECONDS=1.0
EMBEDDING_BATCH_SIZE=32
LLM_TEMPERATURE=0.1

# --- Qdrant (local) ---
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=kavach_chunks
QDRANT_VECTOR_SIZE=768
VECTOR_STORE_BACKEND=qdrant
RETRIEVAL_TOP_K=8
DEFAULT_USER_ID=anonymous

# --- Agent / tools ---
AGENT_MAX_STEPS=6
ANALYSIS_TIMEOUT_SECONDS=10
ANALYSIS_MEMORY_MB=256
ANALYSIS_ALLOWED_IMPORTS=pandas,numpy,math,statistics,json,csv
